<UserControl x:Class="ZikWall.WinUI.GeoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:ZikWall.WinUI.Models" xmlns:presentation="using:ZikWall.WinUI.Presentation">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,260" ColumnSpacing="12"><StackPanel><TextBlock x:Name="GeoStatus" Text="Waiting for connections…" /><TextBlock Text="Offline country estimates · select a marker to see apps and IPs" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><ComboBox x:Name="CountryPicker" Grid.Column="1" PlaceholderText="Select a country" DisplayMemberPath="Label" SelectionChanged="CountrySelected" HorizontalAlignment="Stretch" /></Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="12">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Viewbox Stretch="Uniform"><Grid Width="720" Height="360"><Image Opacity="0.55"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/World.svg" /></Image.Source></Image><Canvas x:Name="Markers" /></Grid></Viewbox></Border>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12"><Grid RowDefinitions="Auto,*"><TextBlock x:Name="DestinationTitle" Text="Select a country" FontWeight="SemiBold" Margin="0,0,0,10" /><ListView x:Name="Destinations" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions><ListView.ItemTemplate><DataTemplate x:DataType="models:ConnectionEntry"><Grid ColumnDefinitions="32,*" ColumnSpacing="8" Padding="0,6"><presentation:AppIcon Executable="{x:Bind ProcessPath}" /><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Application}" /><TextBlock Text="{x:Bind RemoteEndpoint}" IsTextSelectionEnabled="True" FontSize="12" /><TextBlock Text="{x:Bind DirectionLabel}" FontSize="12" /><TextBlock Text="{x:Bind ProcessLabel}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="Markers show approximate country centers, not server or city locations. VPNs and shared hosting affect accuracy. Country data: DB-IP (CC BY 4.0). Map and positions: Natural Earth (public domain)." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
