<UserControl x:Class="ZikWall.WinUI.PolicyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:ZikWall.WinUI.Models">
    <UserControl.Resources><DataTemplate x:Key="PolicyFindingTemplate" x:DataType="models:PolicyFinding"><TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Margin="0,8" /></DataTemplate></UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <InfoBar x:Name="PolicyStatus" IsOpen="True" IsClosable="False" Severity="Informational" Title="Filtering is off" Message="Saved rules are inactive until you enable filtering and approve Windows elevation." />
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnDefinitions="250,*,Auto" ColumnSpacing="12"><ComboBox x:Name="ProfileChoice" Header="Policy profile" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ProfileChanged" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Content="New profile" Click="NewProfileClicked" /><Button Content="Associate network" Click="AssociateClicked" /><ToggleSwitch x:Name="AutoSwitch" Header="Switch by network" Toggled="AutoSwitchChanged" /></StackPanel><Button x:Name="FilteringButton" Grid.Column="2" Content="Enable filtering…" VerticalAlignment="Bottom" Click="FilteringClicked" Style="{ThemeResource AccentButtonStyle}" /></Grid>
            <TextBlock x:Name="NetworkLabel" Text="No network association" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="First matching rule wins within ZikWall. Other firewall providers can still block traffic. Rules apply only while the broker is running; closing ZikWall removes its session filters." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <CommandBar Grid.Row="2" Background="Transparent" HorizontalAlignment="Left" DefaultLabelPosition="Right"><AppBarButton Icon="Add" Label="New rule" Click="NewRuleClicked" /><AppBarButton Icon="Edit" Label="Edit" Click="EditClicked" /><AppBarButton Icon="Delete" Label="Remove" Click="RemoveClicked" /><AppBarButton Icon="Up" Label="Move up" Click="UpClicked" /><AppBarButton Icon="Find" Label="Check rules" Click="CheckRulesClicked" /><AppBarButton Icon="Save" Label="Apply saved policy" Click="ApplyClicked" /></CommandBar>
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><ListView x:Name="PolicyRules" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Saved firewall rules"><ListView.ItemTemplate><DataTemplate x:DataType="models:FirewallRule"><Grid Padding="12" ColumnDefinitions="90,*" ColumnSpacing="16"><TextBlock Text="{x:Bind Action}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" /><TextBlock Text="{x:Bind Scope}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Lifetime}" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
    </Grid>
</UserControl>
