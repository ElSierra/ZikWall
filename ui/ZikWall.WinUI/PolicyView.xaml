<UserControl x:Class="ZikWall.WinUI.PolicyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:ZikWall.WinUI.Models">
    <UserControl.Resources><DataTemplate x:Key="PolicyFindingTemplate" x:DataType="models:PolicyFinding"><TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Margin="0,8" /></DataTemplate></UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <InfoBar x:Name="PolicyStatus" IsOpen="True" IsClosable="False" Severity="Informational" Title="Filtering is off" Message="Saved rules are inactive until you enable filtering and approve Windows elevation." />
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid x:Name="ProfileControls" ColumnDefinitions="250,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12" SizeChanged="ProfileControlsSizeChanged">
                <StackPanel x:Name="ProfileSelector" Spacing="8" VerticalAlignment="Bottom">
                    <TextBlock Text="Policy profile" />
                    <ComboBox x:Name="ProfileChoice" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ProfileChanged" AutomationProperties.Name="Policy profile" />
                </StackPanel>
                <StackPanel x:Name="ProfileActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="New profile" Click="NewProfileClicked" VerticalAlignment="Bottom" />
                    <Button Content="Associate network" Click="AssociateClicked" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel x:Name="NetworkSwitchGroup" Grid.Column="2" Spacing="8" VerticalAlignment="Bottom">
                    <TextBlock Text="Switch by network" />
                    <ToggleSwitch x:Name="AutoSwitch" MinHeight="32" Height="32" Toggled="AutoSwitchChanged" AutomationProperties.Name="Switch by network" />
                </StackPanel>
                <Button x:Name="FilteringButton" Grid.Column="3" Content="Enable filtering…" VerticalAlignment="Bottom" Click="FilteringClicked" Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
            <TextBlock x:Name="NetworkLabel" Text="No network association" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="First matching rule wins within ZikWall. Other firewall providers can still block traffic. Rules apply only while the broker is running; closing ZikWall removes its session filters." TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <CommandBar Grid.Row="2" Background="Transparent" HorizontalAlignment="Left" DefaultLabelPosition="Right"><AppBarButton Icon="Add" Label="New rule" Click="NewRuleClicked" /><AppBarButton Icon="Edit" Label="Edit" Click="EditClicked" /><AppBarButton Icon="Delete" Label="Remove" Click="RemoveClicked" /><AppBarButton Icon="Up" Label="Move up" Click="UpClicked" /><AppBarButton Icon="Find" Label="Check rules" Click="CheckRulesClicked" /><AppBarButton Icon="Save" Label="Apply saved policy" Click="ApplyClicked" /></CommandBar>
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid>
            <ListView x:Name="PolicyRules" SelectionMode="Single" HorizontalContentAlignment="Stretch" Padding="4" AutomationProperties.Name="Saved firewall rules"><ListView.ItemTemplate><DataTemplate x:DataType="models:FirewallRule"><Grid Padding="4,8" ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2,8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{x:Bind Action}" Style="{ThemeResource CaptionTextBlockStyle}" /></Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Scope}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Scope}" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Lifetime}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid></DataTemplate></ListView.ItemTemplate></ListView>
            <StackPanel x:Name="PolicyEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE83D;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="No rules in this profile" HorizontalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Add a rule, or block an app from Connections." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid></Border>
    </Grid>
</UserControl>
