<UserControl x:Class="ZikWall.WinUI.PrivacyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:ZikWall.WinUI.Models">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}"><Setter Property="Margin" Value="0,12,0,4" /></Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer><StackPanel Spacing="4" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,0,12">
        <InfoBar x:Name="PrivacyStatus" IsOpen="True" IsClosable="False" Title="DNS proxy is off" Message="Subscriptions contain data only. Domain lists are used by the local DNS proxy; IP lists can be copied into a saved firewall profile." />

        <TextBlock Text="Encrypted DNS" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
                <TextBox x:Name="DnsEndpoint" Header="DNS-over-HTTPS endpoint" Text="https://cloudflare-dns.com/dns-query" MaxLength="2048" LostFocus="DnsSettingsChanged" />
                <TextBox x:Name="BootstrapAddress" Grid.Column="1" Header="Provider bootstrap IP" Text="1.1.1.1" MaxLength="64" LostFocus="DnsSettingsChanged" ToolTipService.ToolTip="Connects to the provider by IP to avoid a DNS lookup loop." />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button x:Name="DnsButton" Content="Start local DNS proxy" Click="DnsClicked" Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock x:Name="DnsCounts" Grid.Column="1" Text="No DNS queries handled this session." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="Listens on 127.0.0.1:53 (UDP and TCP). To use it system-wide, configure your network adapter's DNS server to 127.0.0.1 yourself. This app does not change adapter settings. Restore your adapter's normal DNS before closing ZikWall or stopping the proxy." TextWrapping="Wrap" Style="{StaticResource Note}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Your chosen provider receives forwarded DNS questions over HTTPS. Apps using their own encrypted DNS, cached addresses or direct IPs can bypass domain blocking. The proxy cannot attribute questions to individual apps." TextWrapping="Wrap" Style="{StaticResource Note}" />
                <TextBlock Text="To show website names in Connections, open Monitor options → Website names → Capture website names. The DNS proxy does not enable name display. DNS can supply domain hints; full HTTPS paths and query strings remain encrypted." TextWrapping="Wrap" Style="{StaticResource Note}" />
            </StackPanel>
        </StackPanel></Border>

        <TextBlock Text="Blocklist subscriptions" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="8"><Grid RowDefinitions="Auto,Auto" RowSpacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsOpen="False">
                    <AppBarButton Icon="Add" Label="Add HTTPS list" Click="AddClicked" />
                    <AppBarButton Icon="Refresh" Label="Refresh lists" Click="RefreshClicked" />
                    <AppBarButton Icon="Delete" Label="Remove selected" Click="RemoveClicked" />
                    <AppBarButton Icon="Copy" Label="Copy IPs to policy" Click="CopyIpsClicked" />
                </CommandBar>
                <CheckBox x:Name="AutomaticUpdates" Grid.Column="1" Content="Refresh every 24 hours" Margin="0,0,8,0" VerticalAlignment="Center" Checked="AutomaticChanged" Unchecked="AutomaticChanged" />
            </Grid>
            <Grid Grid.Row="1" MinHeight="72">
                <ListView x:Name="Subscriptions" SelectionMode="Single" MaxHeight="260" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Blocklist subscriptions"><ListView.ItemTemplate><DataTemplate x:DataType="models:BlocklistSubscription"><StackPanel Padding="0,8" Spacing="2"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Url}" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                <TextBlock Text="No subscriptions yet. Add an HTTPS list of domains or IP ranges." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Note}" Visibility="{x:Bind NoSubscriptions(Subscriptions.ItemsSource), Mode=OneWay}" />
            </Grid>
        </Grid></Border>

        <TextBlock Text="Allowed domains" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
            <TextBox x:Name="Exceptions" PlaceholderText="example.com" Header="One per line; subdomains are included" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button Content="Save domain exceptions" Click="ExceptionsClicked" />
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
