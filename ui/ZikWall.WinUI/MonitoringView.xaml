<UserControl x:Class="ZikWall.WinUI.MonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ZikWall.WinUI.Models" xmlns:presentation="using:ZikWall.WinUI.Presentation">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <!-- Caption styles wrap by default; list cells must stay on one line and trim instead. -->
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="ColumnHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="-6,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <DataTemplate x:Key="UsageHistoryTemplate"><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,6" /></DataTemplate>
        <DataTemplate x:Key="HostEntryTemplate" x:DataType="models:HostEntry">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8" Padding="0,5" ToolTipService.ToolTip="{x:Bind Description}">
                <Image Width="20" Height="15" VerticalAlignment="Top" Margin="0,3,0,0" ><Image.Source><SvgImageSource UriSource="{x:Bind Flag}" RasterizePixelWidth="64" RasterizePixelHeight="48" /></Image.Source></Image>
                <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Details}" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Toolbar: search, the one filter people change often, live state and row actions. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <AutoSuggestBox x:Name="MonitorSearch" PlaceholderText="Search app, domain, IP, port or country" QueryIcon="Find" TextChanged="SearchChanged" VerticalAlignment="Center" AutomationProperties.Name="Search connections" />
            <ComboBox x:Name="ScopeChoice" Grid.Column="1" SelectedIndex="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="MonitorOptionsChanged" AutomationProperties.Name="Show endpoints">
                <ComboBoxItem Content="All endpoints" /><ComboBoxItem Content="Internet only" /><ComboBoxItem Content="Local and listening" />
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="PauseButton" Click="PauseClicked" MinWidth="88" Margin="0,0,6,0" ToolTipService.ToolTip="Pause live updates" AutomationProperties.Name="Pause live updates">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind presentation:Ui.Active}" /><TextBlock x:Name="LiveText" Text="Live" /></StackPanel>
                </Button>
                <Button x:Name="DetailsButton" Style="{StaticResource IconButton}" Click="DetailsClicked" ToolTipService.ToolTip="Details" AutomationProperties.Name="Details"><FontIcon Glyph="&#xE946;" FontSize="16" /></Button>
                <Button x:Name="BlockButton" Style="{StaticResource IconButton}" Click="BlockAppClicked" ToolTipService.ToolTip="Block selected app…" AutomationProperties.Name="Block selected app"><FontIcon Glyph="&#xE711;" FontSize="16" /></Button>
                <Button Style="{StaticResource IconButton}" Click="ExportClicked" ToolTipService.ToolTip="Export CSV" AutomationProperties.Name="Export CSV"><FontIcon Glyph="&#xEDE1;" FontSize="16" /></Button>
                <Button x:Name="OptionsButton" Style="{StaticResource IconButton}" Click="OptionsClicked" ToolTipService.ToolTip="Open monitor options window" AutomationProperties.Name="Monitor options"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="OptionsParking" Visibility="Collapsed">
            <ScrollViewer x:Name="OptionsContent" HorizontalAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel Spacing="20" Padding="2" SizeChanged="OptionsSizeChanged">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Website names" Style="{StaticResource SectionTitle}" />
                        <Button x:Name="DomainButton" Content="Capture website names" Click="DomainClicked" />
                        <TextBlock Text="Capture learns names from ordinary DNS replies for browsers and other apps while enabled. Requires administrator access. Names stay in memory until they expire or you stop capture." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="ReverseDnsLookup" Header="Look up missing hostnames" Toggled="ReverseDnsChanged" />
                        <TextBlock Text="Optional reverse DNS sends public IP lookups to your DNS resolver. Names may identify a server or CDN rather than the website. Results appear gradually while monitoring." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DomainStatus" Text="Checking the Windows DNS cache…" Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="The Hosts column shows a name or IP and the number of other hosts. Select it for the full list. Shared IPs can have several names. Encrypted DNS cannot be read by capture; HTTPS paths and query strings stay encrypted." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="View" Style="{StaticResource SectionTitle}" />
                        <ToggleSwitch x:Name="HideSystemApps" Header="Hide Windows system apps" Toggled="HideSystemAppsChanged" />
                        <TextBlock Text="Hide Windows components and built-in system packages from Connections, Activity and the map, and mute their connection alerts. Turn off to show them again. Monitoring and firewall rules continue unchanged." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <Grid x:Name="ViewOptionsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <ComboBox x:Name="GroupChoice" Header="Group" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="By app" /><ComboBoxItem Content="No grouping" /></ComboBox>
                            <ComboBox x:Name="DirectionChoice" Grid.Column="1" Header="Direction" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Both" /><ComboBoxItem Content="Outgoing" /><ComboBoxItem Content="Incoming" /></ComboBox>
                            <ComboBox x:Name="RefreshChoice" Grid.Column="2" Header="Refresh every" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="RefreshIntervalChanged"><ComboBoxItem Content="2 seconds" /><ComboBoxItem Content="5 seconds" /><ComboBoxItem Content="10 seconds" /></ComboBox>
                        </Grid>
                        <TextBlock Text="5 seconds uses the least resources. Hidden or minimized windows sample every 15 seconds." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Adapter traffic" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="AdapterOptionsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <ComboBox x:Name="AdapterChoice" Header="Adapter" HorizontalAlignment="Stretch" SelectionChanged="AdapterChanged" DisplayMemberPath="Name" />
                            <ComboBox x:Name="HistoryWindow" Grid.Column="1" Header="Chart and activity range" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Last hour" /><ComboBoxItem Content="Last 24 hours" /><ComboBoxItem Content="Last 7 days" /></ComboBox>
                        </Grid>
                        <Border Style="{StaticResource StatTile}" Padding="8">
                            <Canvas x:Name="TrafficChart" Height="110" SizeChanged="ChartSizeChanged" AutomationProperties.Name="Selected adapter traffic chart"><Polyline x:Name="DownloadLine" Stroke="{x:Bind presentation:Ui.Incoming}" StrokeThickness="2" /><Polyline x:Name="UploadLine" Stroke="{x:Bind presentation:Ui.Outgoing}" StrokeThickness="2" /></Canvas>
                        </Border>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{x:Bind presentation:Ui.Incoming}" /><TextBlock Text="Download" Style="{StaticResource StatLabel}" /><Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="{x:Bind presentation:Ui.Outgoing}" /><TextBlock Text="Upload" Style="{StaticResource StatLabel}" /></StackPanel>
                            <TextBlock x:Name="ChartScale" Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Whole-adapter totals, not per-app traffic." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                        <ComboBox x:Name="NotificationTypeChoice" Header="Notify me about" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="NotificationTypeChanged">
                            <ComboBoxItem Content="All new Internet connections" />
                            <ComboBoxItem Content="New apps only" />
                            <ComboBoxItem Content="Outgoing connections only" />
                            <ComboBoxItem Content="Incoming connections only" />
                        </ComboBox>
                        <TextBlock Text="Applies to banners and Windows notifications. New apps means the first Internet connection observed per app in this session; apps already connected at startup stay quiet. Alerts are grouped at most once every 30 seconds." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <Grid x:Name="NotificationOptionsGrid" ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <ToggleSwitch x:Name="RecentAlerts" Header="In-app banner" IsOn="True" Toggled="RecentAlertsChanged" />
                            <ToggleSwitch x:Name="DesktopAlerts" Grid.Column="1" Header="Windows notifications" Toggled="DesktopAlertsChanged" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="History" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="HistoryOptionsGrid" ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <ToggleSwitch x:Name="SaveHistory" Header="Save activity on this PC" Toggled="SaveHistoryChanged" />
                            <Button Grid.Column="1" Content="Clear history…" Click="ClearHistoryClicked" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            <ToggleSwitch x:Name="TcpDetails" Grid.Row="1" Header="Show TCP details in history" Toggled="TcpDetailsChanged" ToolTipService.ToolTip="Include TCP state changes, connection teardown and sockets whose app already exited." />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Per-app usage" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="UsageOptionsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"><Button x:Name="UsageButton" Content="Enable usage" Click="UsageClicked" /><Button Grid.Column="1" Content="All app usage…" Click="AllUsageClicked" /></Grid>
                        <TextBlock x:Name="UsageStatus" Text="Usage is off. Enabled usage resumes after a restart with a Windows permission prompt. Daily totals retain 30 days; network traffic includes local connections." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="About this data" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Direction comes from Windows TCP SYN options; unavailable results stay Unknown. Flags are approximate offline IP locations. Snapshots can miss short connections; UDP destinations are unavailable." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <TextBlock x:Name="CountryDataStatus" Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                        <HyperlinkButton Content="Country and network data: DB-IP · CC BY 4.0" NavigateUri="https://db-ip.com" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Live summary: the numbers match the filtered list below. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,2.2*" ColumnSpacing="8" Margin="0,0,0,8">
            <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="Apps" Style="{StaticResource StatLabel}" /><TextBlock x:Name="StatApps" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="Connections" Style="{StaticResource StatLabel}" /><TextBlock x:Name="StatConnections" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="Countries" Style="{StaticResource StatLabel}" /><TextBlock x:Name="StatCountries" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource StatTile}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <StackPanel>
                        <TextBlock x:Name="TrafficAdapter" Text="Network traffic" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE74B;" FontSize="12" Foreground="{x:Bind presentation:Ui.Incoming}" /><TextBlock x:Name="RateDown" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE74A;" FontSize="12" Foreground="{x:Bind presentation:Ui.Outgoing}" /><TextBlock x:Name="RateUp" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Canvas x:Name="Sparkline" Grid.Column="1" Height="36" VerticalAlignment="Center" SizeChanged="ChartSizeChanged" AutomationProperties.Name="Recent adapter traffic">
                        <Polyline x:Name="SparkDown" Stroke="{x:Bind presentation:Ui.Incoming}" StrokeThickness="1.5" />
                        <Polyline x:Name="SparkUp" Stroke="{x:Bind presentation:Ui.Outgoing}" StrokeThickness="1.5" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <!-- Closed banners collapse so they leave no gap above the list. -->
        <StackPanel Grid.Row="2">
            <InfoBar x:Name="RecentBanner" IsOpen="False" IsClosable="True" Severity="Informational" Title="New connections" Margin="0,0,0,8" Visibility="{x:Bind RecentBanner.IsOpen, Mode=OneWay}" />
            <InfoBar x:Name="ActionBanner" IsOpen="False" IsClosable="True" Severity="Informational" Title="Connection action" Margin="0,0,0,8" Visibility="{x:Bind ActionBanner.IsOpen, Mode=OneWay}" />
        </StackPanel>

        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="ConnectionHeader" Padding="20,8" MinHeight="40" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1*" /><ColumnDefinition x:Name="UsageHeaderColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Button Content="App / connection" Click="AppSortClicked" Margin="48,0,0,0" ToolTipService.ToolTip="Sort apps by name" Style="{StaticResource ColumnHeaderButton}" />
                    <TextBlock Grid.Column="1" Text="Direction" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Hosts / status" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Location" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                    <Button x:Name="UsageSortButton" Grid.Column="4" Content="Usage today" Click="UsageSortClicked" Visibility="Collapsed" Style="{StaticResource ColumnHeaderButton}" ToolTipService.ToolTip="Sort by today's downloaded + uploaded bytes. Click again to reverse." AutomationProperties.Name="Sort usage today, highest first" />
                </Grid>
                <ListView x:Name="ConnectionList" Grid.Row="1" Padding="0,0,10,0" HorizontalContentAlignment="Stretch" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ActivityClicked" SelectionChanged="SelectionChanged" ContextRequested="ConnectionsContextRequested" AutomationProperties.Name="Apps, processes and connections">
                    <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ActivityRow"><Grid Padding="4,6" MinHeight="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="{x:Bind presentation:Ui.UsageColumnWidth(UsageVisible), Mode=OneWay}" /></Grid.ColumnDefinitions>
                        <Grid ColumnDefinitions="Auto,20,Auto,*">
                            <Border Width="{x:Bind Indent, Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <presentation:AppIcon Grid.Column="2" Executable="{x:Bind ProcessPath, Mode=OneWay}" />
                            <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TitleHint, Mode=OneWay}" />
                                    <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind presentation:Ui.Opacity(IsNew), Mode=OneWay}" ToolTipService.ToolTip="New since the last refresh" />
                                </Grid>
                                <TextBlock Text="{x:Bind Details, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Details, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind presentation:Ui.DirectionGlyph(Direction), Mode=OneWay}" FontSize="12" Foreground="{x:Bind presentation:Ui.DirectionBrush(Direction), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind presentation:Ui.DirectionText(Direction), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,2" MinWidth="0" MinHeight="24" Background="Transparent" BorderThickness="0" Click="HostsClicked" Tag="{x:Bind Hosts, Mode=OneWay}" IsEnabled="{x:Bind HasHosts, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind HostDescription, Mode=OneWay}" AutomationProperties.Name="{x:Bind HostTitle, Mode=OneWay}">
                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="6">
                                    <Image Width="20" Height="15" VerticalAlignment="Center"><Image.Source><SvgImageSource UriSource="{x:Bind HostFlag, Mode=OneWay}" RasterizePixelWidth="64" RasterizePixelHeight="48" /></Image.Source></Image>
                                    <TextBlock Grid.Column="1" Text="{x:Bind HostPrimary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource CountPill}" Visibility="{x:Bind presentation:Ui.Show(HostMore), Mode=OneWay}"><TextBlock Text="{x:Bind HostMore, Mode=OneWay}" Style="{StaticResource StatLabel}" /></Border>
                                </Grid>

                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind presentation:Ui.StateBrush(State), Mode=OneWay}" Visibility="{x:Bind presentation:Ui.Show(State), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind State, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind presentation:Ui.Show(State), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Endpoint, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{x:Bind CountryFlags, Mode=OneWay}" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Image Width="20" Height="15" ><Image.Source><SvgImageSource UriSource="{x:Bind}" RasterizePixelWidth="64" RasterizePixelHeight="48" /></Image.Source></Image></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="{x:Bind Country, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Country, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Visibility="{x:Bind presentation:Ui.ShowIf(UsageVisible), Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind UsageHint, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Total, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Usage, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="HistoryList" ContextRequested="HistoryContextRequested" Grid.Row="1" HorizontalContentAlignment="Stretch" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="SelectionChanged" AutomationProperties.Name="Connection history">
                    <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ConnectionEvent"><Grid Padding="4,8" ColumnDefinitions="96,32,*,170" ColumnSpacing="12">
                        <TextBlock Text="{x:Bind TimeLabel}" VerticalAlignment="Center" Style="{StaticResource StatLabel}" ToolTipService.ToolTip="{x:Bind FullTime}" />
                        <presentation:AppIcon Grid.Column="1" Executable="{x:Bind Connection.ProcessPath}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Details}"><TextBlock Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Endpoints}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" /></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{x:Bind presentation:Ui.DirectionGlyph(Connection.Direction)}" FontSize="12" Foreground="{x:Bind presentation:Ui.DirectionBrush(Connection.Direction)}" /><TextBlock Text="{x:Bind presentation:Ui.DirectionText(Connection.Direction)}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"><Image Width="20" Height="15" ><Image.Source><SvgImageSource UriSource="{x:Bind Connection.CountryFlag}" RasterizePixelWidth="64" RasterizePixelHeight="48" /></Image.Source></Image><TextBlock Text="{x:Bind Connection.NetworkLabel}" ToolTipService.ToolTip="{x:Bind Connection.PlaceDescription}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" /></StackPanel>
                        </StackPanel>
                    </Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyList" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="Reading Windows connection tables…" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="MonitorStatus" Grid.Row="4" Text="Reading Windows connection tables…" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
