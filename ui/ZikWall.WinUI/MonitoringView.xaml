<UserControl x:Class="ZikWall.WinUI.MonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ZikWall.WinUI.Models" xmlns:presentation="using:ZikWall.WinUI.Presentation">
    <UserControl.Resources><DataTemplate x:Key="ConnectionGroupHeader" x:DataType="models:ConnectionGroup"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Margin="16,12,0,4" /></DataTemplate></UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <AutoSuggestBox x:Name="MonitorSearch" PlaceholderText="Search app, PID, IP address or port" QueryIcon="Find" TextChanged="SearchChanged" AutomationProperties.Name="Search connections" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="UsageButton" Content="Enable usage" Click="UsageClicked" /><Button Content="Options"><Button.Flyout><Flyout x:Name="MonitorOptions" Opened="OptionsOpened"><ScrollViewer MaxHeight="580" MaxWidth="820"><StackPanel Spacing="16"><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="GroupChoice" Header="Display" SelectedIndex="0" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Apps and processes" /><ComboBoxItem Content="All connections" /></ComboBox><ComboBox x:Name="ScopeChoice" Header="Show" SelectedIndex="1" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="All endpoints" /><ComboBoxItem Content="Internet" /><ComboBoxItem Content="Local / listening" /></ComboBox><ComboBox x:Name="DirectionChoice" Header="Direction" SelectedIndex="0" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Both directions" /><ComboBoxItem Content="Outgoing" /><ComboBoxItem Content="Incoming" /></ComboBox></StackPanel><Button Content="All app usage…" Click="AllUsageClicked" HorizontalAlignment="Left" /><TextBlock x:Name="UsageStatus" Text="Usage is off. Enabling requires Windows UAC for this session. Daily totals retain 30 days; network traffic includes local connections. Sign-in startup itself stays unelevated." TextWrapping="Wrap" MaxWidth="760" /><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="HistoryWindow" Header="History / chart range" SelectedIndex="0" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Last hour" /><ComboBoxItem Content="Last 24 hours" /><ComboBoxItem Content="Last 7 days" /></ComboBox><ComboBox x:Name="RefreshChoice" Header="Refresh interval" SelectedIndex="1" SelectionChanged="RefreshIntervalChanged"><ComboBoxItem Content="2 seconds" /><ComboBoxItem Content="5 seconds · low resource" /><ComboBoxItem Content="10 seconds" /></ComboBox></StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock x:Name="MonitorStatus" Text="Reading Windows connection tables…" TextWrapping="Wrap" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><ToggleSwitch x:Name="SaveHistory" Header="Save activity locally" Toggled="SaveHistoryChanged" /><Button Content="Clear history" Click="ClearHistoryClicked" VerticalAlignment="Bottom" /></StackPanel></Grid>
            <StackPanel Orientation="Horizontal" Spacing="20"><ToggleSwitch x:Name="RecentAlerts" Header="Recent connection alerts" IsOn="True" Toggled="RecentAlertsChanged" /><ToggleSwitch x:Name="DesktopAlerts" Header="Windows notifications" Toggled="DesktopAlertsChanged" /><HyperlinkButton Content="Country data: DB-IP · CC BY 4.0" NavigateUri="https://db-ip.com" VerticalAlignment="Bottom" /></StackPanel>
            <TextBlock Text="Direction is reported from Windows TCP SYN options; unavailable results stay Unknown. Country flags are approximate offline IP locations. Snapshots can miss short connections; UDP destinations are unavailable. Background/minimized sampling: 15 seconds." Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnDefinitions="250,*" ColumnSpacing="20">
                <StackPanel Spacing="8"><ComboBox x:Name="AdapterChoice" Header="Network adapter traffic" HorizontalAlignment="Stretch" SelectionChanged="AdapterChanged" DisplayMemberPath="Name" /><TextBlock x:Name="TrafficRates" Text="Waiting for traffic samples…" /><TextBlock x:Name="ChartScale" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="Blue: download · Purple: upload" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="Adapter totals, not per-app traffic." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <Canvas x:Name="TrafficChart" Grid.Column="1" Height="110" VerticalAlignment="Center" SizeChanged="ChartSizeChanged" AutomationProperties.Name="Selected adapter traffic chart"><Polyline x:Name="DownloadLine" Stroke="#168AE0" StrokeThickness="2" /><Polyline x:Name="UploadLine" Stroke="#A86EF5" StrokeThickness="2" /></Canvas>
            </Grid>
        </Border>
</StackPanel></ScrollViewer></Flyout></Button.Flyout></Button><Button x:Name="PauseButton" Content="Pause" Click="PauseClicked" /><Button Content="Details" Click="DetailsClicked" /><Button Content="Block app…" Click="BlockAppClicked" /><Button Content="Export CSV" Click="ExportClicked" /></StackPanel>
        </Grid>


        <InfoBar x:Name="RecentBanner" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" Title="Recent connections" />
        <InfoBar x:Name="ActionBanner" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational" Title="Connection action" />
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="ConnectionHeader" Padding="20,10" ColumnDefinitions="2.3*,110,1*,1*,150" ColumnSpacing="12"><TextBlock Text="Application / connection" /><TextBlock Grid.Column="1" Text="Direction" /><TextBlock Grid.Column="2" Text="Destination" /><TextBlock Grid.Column="3" Text="Country / state" /><TextBlock Grid.Column="4" Text="Observed traffic · today*" /></Grid>
                <ListView x:Name="ConnectionList" Grid.Row="1" HorizontalContentAlignment="Stretch" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ActivityClicked" ContextRequested="ConnectionsContextRequested" AutomationProperties.Name="Apps, processes and connections">
                    <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ActivityRow"><Grid Padding="4,6" ColumnDefinitions="2.3*,110,1*,1*,150" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal"><Border Width="{x:Bind Indent}" /><TextBlock Text="{x:Bind Chevron}" Width="22" VerticalAlignment="Center" /><presentation:AppIcon Executable="{x:Bind ProcessPath}" /><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxWidth="320" HorizontalAlignment="Left" ToolTipService.ToolTip="{x:Bind ProcessPath}" /><TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="320" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Direction}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Endpoint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><ItemsControl ItemsSource="{x:Bind CountryFlags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Image Source="{x:Bind}" Width="20" Height="16" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{x:Bind Country}" TextTrimming="CharacterEllipsis" MaxWidth="140" ToolTipService.ToolTip="{x:Bind Country}" /></StackPanel><TextBlock Text="{x:Bind State}" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{x:Bind Usage}" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{x:Bind Total}" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel>
                    </Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="HistoryList" ContextRequested="HistoryContextRequested" Grid.Row="1" HorizontalContentAlignment="Stretch" Visibility="Collapsed" SelectionMode="Single" AutomationProperties.Name="Connection history"><ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions><ListView.ItemTemplate><DataTemplate x:DataType="models:ConnectionEvent"><Grid Padding="8,10" ColumnDefinitions="150,32,*,140" ColumnSpacing="12"><TextBlock Text="{x:Bind TimeLabel}" /><presentation:AppIcon Grid.Column="1" Executable="{x:Bind Connection.ProcessPath}" /><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{x:Bind Summary}" /><TextBlock Text="{x:Bind Endpoints}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="{x:Bind Connection.DirectionLabel}" /><StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{x:Bind Connection.CountryFlag}" Width="26" Height="20" /><TextBlock Text="{x:Bind Connection.CountryCode}" /></StackPanel></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
