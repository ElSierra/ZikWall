<UserControl x:Class="ZikWall.WinUI.MonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ZikWall.WinUI.Models" xmlns:presentation="using:ZikWall.WinUI.Presentation">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Storyboard x:Key="LivePulse"><DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.6" /></Storyboard>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <!-- Toolbar: search, the one filter people change often, live state and row actions. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <AutoSuggestBox x:Name="MonitorSearch" PlaceholderText="Search app, PID, IP address, port or country" QueryIcon="Find" TextChanged="SearchChanged" VerticalAlignment="Center" AutomationProperties.Name="Search connections" />
            <ComboBox x:Name="ScopeChoice" Grid.Column="1" SelectedIndex="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="MonitorOptionsChanged" AutomationProperties.Name="Show endpoints">
                <ComboBoxItem Content="All endpoints" /><ComboBoxItem Content="Internet only" /><ComboBoxItem Content="Local and listening" />
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="PauseButton" Click="PauseClicked" MinWidth="88" Margin="0,0,6,0" ToolTipService.ToolTip="Pause live updates" AutomationProperties.Name="Pause live updates">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind presentation:Ui.Active}" /><TextBlock x:Name="LiveText" Text="Live" /></StackPanel>
                </Button>
                <Button x:Name="DetailsButton" Style="{StaticResource IconButton}" Click="DetailsClicked" ToolTipService.ToolTip="Details" AutomationProperties.Name="Details"><FontIcon Glyph="&#xE946;" FontSize="16" /></Button>
                <Button x:Name="BlockButton" Style="{StaticResource IconButton}" Click="BlockAppClicked" ToolTipService.ToolTip="Block selected app…" AutomationProperties.Name="Block selected app"><FontIcon Glyph="&#xE711;" FontSize="16" /></Button>
                <Button Style="{StaticResource IconButton}" Click="ExportClicked" ToolTipService.ToolTip="Export CSV" AutomationProperties.Name="Export CSV"><FontIcon Glyph="&#xEDE1;" FontSize="16" /></Button>
                <Button Style="{StaticResource IconButton}" ToolTipService.ToolTip="View options, traffic chart, history and usage" AutomationProperties.Name="Monitor options"><FontIcon Glyph="&#xE713;" FontSize="16" />
                    <Button.Flyout><Flyout x:Name="MonitorOptions" Opened="OptionsOpened" Placement="BottomEdgeAlignedRight">
                        <ScrollViewer MaxHeight="640" Width="560" Padding="0,0,12,0">
                            <StackPanel Spacing="20" Padding="2">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="View" Style="{StaticResource SectionTitle}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <ComboBox x:Name="GroupChoice" Header="Group" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="By app" /><ComboBoxItem Content="No grouping" /></ComboBox>
                                        <ComboBox x:Name="DirectionChoice" Grid.Column="1" Header="Direction" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Both" /><ComboBoxItem Content="Outgoing" /><ComboBoxItem Content="Incoming" /></ComboBox>
                                        <ComboBox x:Name="RefreshChoice" Grid.Column="2" Header="Refresh every" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="RefreshIntervalChanged"><ComboBoxItem Content="2 seconds" /><ComboBoxItem Content="5 seconds" /><ComboBoxItem Content="10 seconds" /></ComboBox>
                                    </Grid>
                                    <TextBlock Text="5 seconds uses the least resources. Hidden or minimized windows sample every 15 seconds." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Adapter traffic" Style="{StaticResource SectionTitle}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <ComboBox x:Name="AdapterChoice" Header="Adapter" HorizontalAlignment="Stretch" SelectionChanged="AdapterChanged" DisplayMemberPath="Name" />
                                        <ComboBox x:Name="HistoryWindow" Grid.Column="1" Header="Chart and activity range" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorOptionsChanged"><ComboBoxItem Content="Last hour" /><ComboBoxItem Content="Last 24 hours" /><ComboBoxItem Content="Last 7 days" /></ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource StatTile}" Padding="8">
                                        <Canvas x:Name="TrafficChart" Height="110" SizeChanged="ChartSizeChanged" AutomationProperties.Name="Selected adapter traffic chart"><Polyline x:Name="DownloadLine" Stroke="{x:Bind presentation:Ui.Incoming}" StrokeThickness="2" /><Polyline x:Name="UploadLine" Stroke="{x:Bind presentation:Ui.Outgoing}" StrokeThickness="2" /></Canvas>
                                    </Border>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{x:Bind presentation:Ui.Incoming}" /><TextBlock Text="Download" Style="{StaticResource StatLabel}" /><Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="{x:Bind presentation:Ui.Outgoing}" /><TextBlock Text="Upload" Style="{StaticResource StatLabel}" /></StackPanel>
                                        <TextBlock x:Name="ChartScale" Grid.Column="1" Style="{StaticResource StatLabel}" TextAlignment="Right" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="Whole-adapter totals, not per-app traffic." Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="History and alerts" Style="{StaticResource SectionTitle}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                        <ToggleSwitch x:Name="RecentAlerts" Header="New connection banner" IsOn="True" Toggled="RecentAlertsChanged" />
                                        <ToggleSwitch x:Name="DesktopAlerts" Grid.Column="1" Header="Windows notifications" Toggled="DesktopAlertsChanged" />
                                        <ToggleSwitch x:Name="SaveHistory" Grid.Row="1" Header="Save activity on this PC" Toggled="SaveHistoryChanged" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="Clear history…" Click="ClearHistoryClicked" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Per-app usage" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="UsageButton" Content="Enable usage" Click="UsageClicked" /><Button Content="All app usage…" Click="AllUsageClicked" /></StackPanel>
                                    <TextBlock x:Name="UsageStatus" Text="Usage is off. Enabling requires Windows UAC for this session. Daily totals retain 30 days; network traffic includes local connections. Sign-in startup itself stays unelevated." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="About this data" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Direction comes from Windows TCP SYN options; unavailable results stay Unknown. Flags are approximate offline IP locations. Snapshots can miss short connections; UDP destinations are unavailable." Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CountryDataStatus" Style="{StaticResource StatLabel}" TextWrapping="Wrap" />
                                    <HyperlinkButton Content="Country data: DB-IP · CC BY 4.0" NavigateUri="https://db-ip.com" Padding="0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Live summary: the numbers match the filtered list below. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,2.2*" ColumnSpacing="8">
            <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="Apps" Style="{StaticResource StatLabel}" /><TextBlock x:Name="StatApps" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="Connections" Style="{StaticResource StatLabel}" /><TextBlock x:Name="StatConnections" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="Countries" Style="{StaticResource StatLabel}" /><TextBlock x:Name="StatCountries" Text="—" Style="{StaticResource StatValue}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource StatTile}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <StackPanel>
                        <TextBlock x:Name="TrafficAdapter" Text="Network traffic" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE74B;" FontSize="12" Foreground="{x:Bind presentation:Ui.Incoming}" /><TextBlock x:Name="RateDown" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE74A;" FontSize="12" Foreground="{x:Bind presentation:Ui.Outgoing}" /><TextBlock x:Name="RateUp" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Canvas x:Name="Sparkline" Grid.Column="1" Height="36" VerticalAlignment="Center" SizeChanged="ChartSizeChanged" AutomationProperties.Name="Recent adapter traffic">
                        <Polyline x:Name="SparkDown" Stroke="{x:Bind presentation:Ui.Incoming}" StrokeThickness="1.5" />
                        <Polyline x:Name="SparkUp" Stroke="{x:Bind presentation:Ui.Outgoing}" StrokeThickness="1.5" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="RecentBanner" IsOpen="False" IsClosable="True" Severity="Informational" Title="New connections" />
            <InfoBar x:Name="ActionBanner" IsOpen="False" IsClosable="True" Severity="Informational" Title="Connection action" />
        </StackPanel>

        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="ConnectionHeader" Padding="20,10" ColumnDefinitions="2.4*,120,1.1*,1.3*" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="App / connection" Style="{StaticResource StatLabel}" />
                    <TextBlock Grid.Column="1" Text="Direction" Style="{StaticResource StatLabel}" />
                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource StatLabel}" />
                    <TextBlock Grid.Column="3" Text="Location" Style="{StaticResource StatLabel}" />
                </Grid>
                <ListView x:Name="ConnectionList" Grid.Row="1" HorizontalContentAlignment="Stretch" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ActivityClicked" SelectionChanged="SelectionChanged" ContextRequested="ConnectionsContextRequested" AutomationProperties.Name="Apps, processes and connections">
                    <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ActivityRow"><Grid Padding="4,6" MinHeight="44" ColumnDefinitions="2.4*,120,1.1*,1.3*" ColumnSpacing="12">
                        <Grid ColumnDefinitions="Auto,20,Auto,*">
                            <Border Width="{x:Bind Indent}" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind ChevronGlyph}" FontSize="10" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <presentation:AppIcon Grid.Column="2" Executable="{x:Bind ProcessPath}" />
                            <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ProcessPath}" />
                                    <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind presentation:Ui.Opacity(IsNew)}" ToolTipService.ToolTip="New since the last refresh" />
                                </Grid>
                                <TextBlock Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind presentation:Ui.DirectionGlyph(Direction)}" FontSize="12" Foreground="{x:Bind presentation:Ui.DirectionBrush(Direction)}" />
                            <TextBlock Text="{x:Bind presentation:Ui.DirectionText(Direction)}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind presentation:Ui.StateBrush(State)}" Visibility="{x:Bind presentation:Ui.Show(State)}" />
                                <TextBlock Text="{x:Bind State}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind presentation:Ui.Show(State)}" />
                                <TextBlock Text="{x:Bind Endpoint}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Usage}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" Visibility="{x:Bind presentation:Ui.Show(Usage)}" ToolTipService.ToolTip="Observed app traffic rate" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{x:Bind CountryFlags}" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Image Source="{x:Bind}" Width="20" Height="15" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="{x:Bind Country}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Country}" />
                        </StackPanel>
                    </Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="HistoryList" ContextRequested="HistoryContextRequested" Grid.Row="1" HorizontalContentAlignment="Stretch" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="SelectionChanged" AutomationProperties.Name="Connection history">
                    <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ConnectionEvent"><Grid Padding="4,8" ColumnDefinitions="140,32,*,170" ColumnSpacing="12">
                        <TextBlock Text="{x:Bind TimeLabel}" VerticalAlignment="Center" Style="{StaticResource StatLabel}" />
                        <presentation:AppIcon Grid.Column="1" Executable="{x:Bind Connection.ProcessPath}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Endpoints}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" /></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{x:Bind presentation:Ui.DirectionGlyph(Connection.Direction)}" FontSize="12" Foreground="{x:Bind presentation:Ui.DirectionBrush(Connection.Direction)}" /><TextBlock Text="{x:Bind Connection.Direction}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{x:Bind Connection.CountryFlag}" Width="20" Height="15" /><TextBlock Text="{x:Bind Connection.CountryLabel}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatLabel}" /></StackPanel>
                        </StackPanel>
                    </Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyList" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="Reading Windows connection tables…" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="MonitorStatus" Grid.Row="4" Text="Reading Windows connection tables…" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
