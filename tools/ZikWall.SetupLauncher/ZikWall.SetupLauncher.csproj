<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>setup</AssemblyName>
    <Product>ZikWall Setup</Product>
    <Company>isaacojo.me</Company>
    <ApplicationIcon>..\..\ui\ZikWall.WinUI\Assets\ZikWall.ico</ApplicationIcon>
    <ApplicationManifest>..\..\ui\ZikWall.WinUI\app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(SetupPayloadPath)" LogicalName="SetupPayload.zip" />
    <AssemblyMetadata Include="PayloadSha256" Value="$(PayloadSha256)" />
  </ItemGroup>
</Project>
